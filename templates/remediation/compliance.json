{
  "cis_benchmark_fail": {
    "match_pattern": "(CIS|benchmark).*(başarısız|fail|uyumsuz)",
    "title": "CIS Benchmark Uyumsuzluğu",
    "description": "Sistem CIS güvenlik benchmark'ına uymuyor.",
    "impact": "Endüstri standartlarına uyumsuzluk, güvenlik denetimleri sorun yaşanabilir.",
    "steps": [
      {
        "instruction": "CIS benchmark raporunu inceleyin",
        "command": "sudo lynis audit system"
      },
      {
        "instruction": "Spesifik uyumsuzlukları düzeltin",
        "tip": "Her bulgu için önerilen düzeltmeyi uygulayın"
      }
    ]
  },
  "cis_cramfs": {
    "match_pattern": "CIS.*1\\.1\\.1\\.1.*cramfs|cramfs.*modülü.*yüklü",
    "title": "CIS 1.1.1.1: cramfs Modülü Yüklü",
    "description": "cramfs dosya sistemi modülü yüklü, kullanılmıyorsa güvenlik riski.",
    "steps": [
      {
        "instruction": "Modülü kara listeye ekleyin",
        "command": "echo 'install cramfs /bin/true' | sudo tee /etc/modprobe.d/cramfs.conf"
      },
      {
        "instruction": "Modülü kaldırın (yüklüyse)",
        "command": "sudo modprobe -r cramfs 2>/dev/null || true"
      }
    ],
    "verification": {
      "command": "lsmod | grep cramfs",
      "expected": "Hiçbir sonuç dönmemeli"
    }
  },
  "cis_tmp_partition": {
    "match_pattern": "CIS.*1\\.1\\.2.*/tmp.*partition|/tmp.*ayrı.*partition.*değil",
    "title": "CIS 1.1.2: /tmp Ayrı Partition Değil",
    "description": "/tmp ayrı bir partition olarak mount edilmemiş.",
    "impact": "Disk dolum saldırılarına ve noexec korumasına engel.",
    "steps": [
      {
        "instruction": "Mevcut mount durumunu kontrol edin",
        "command": "mount | grep /tmp"
      },
      {
        "instruction": "tmpfs olarak /tmp mount edin",
        "command": "echo 'tmpfs /tmp tmpfs defaults,noexec,nosuid,nodev 0 0' | sudo tee -a /etc/fstab"
      },
      {
        "instruction": "Değişiklikleri uygulayın",
        "command": "sudo mount -o remount /tmp",
        "tip": "Veya sistemi yeniden başlatın"
      }
    ]
  },
  "cis_aide": {
    "match_pattern": "CIS.*1\\.3\\.1.*AIDE.*kurulu.*değil|AIDE.*kurulu.*değil",
    "title": "CIS 1.3.1: AIDE Kurulu Değil",
    "description": "Dosya bütünlük kontrolü için AIDE kurulu değil.",
    "impact": "Dosya değişiklikleri tespit edilemez.",
    "steps": [
      {
        "instruction": "AIDE'yi kurun",
        "command": "sudo apt install aide aide-common"
      },
      {
        "instruction": "Veritabanını başlatın",
        "command": "sudo aideinit",
        "note": "Bu işlem biraz zaman alabilir"
      },
      {
        "instruction": "Düzenli kontrol için cron job ekleyin",
        "command": "echo '0 5 * * * /usr/bin/aide --check' | sudo tee /etc/cron.d/aide"
      }
    ],
    "verification": {
      "command": "dpkg -l | grep aide",
      "expected": "aide paketi kurulu gösterilmeli"
    }
  },
  "cis_grub_password": {
    "match_pattern": "CIS.*1\\.4\\.1.*GRUB.*şifre|GRUB.*şifre.*koruması.*yok",
    "title": "CIS 1.4.1: GRUB Şifre Koruması Yok",
    "description": "Bootloader şifre koruması yapılandırılmamış.",
    "impact": "Fiziksel erişimle boot parametreleri değiştirilebilir.",
    "steps": [
      {
        "instruction": "GRUB şifresi oluşturun",
        "command": "grub-mkpasswd-pbkdf2",
        "note": "Oluşan hash'i kopyalayın"
      },
      {
        "instruction": "GRUB yapılandırmasına ekleyin",
        "command": "sudo nano /etc/grub.d/40_custom"
      },
      {
        "instruction": "Şu satırları ekleyin",
        "command": "set superusers=\"admin\"\npassword_pbkdf2 admin HASH_DEGERI"
      },
      {
        "instruction": "GRUB'u güncelleyin",
        "command": "sudo update-grub"
      }
    ]
  },
  "cis_core_dump": {
    "match_pattern": "CIS.*1\\.5\\.1.*core.*dump.*kısıtlanmamış|Core.*dump.*kısıtlanmamış",
    "title": "CIS 1.5.1: Core Dump Kısıtlanmamış",
    "description": "Core dump'lar hassas bilgiler içerebilir.",
    "steps": [
      {
        "instruction": "limits.conf'u düzenleyin",
        "command": "echo '* hard core 0' | sudo tee -a /etc/security/limits.conf"
      },
      {
        "instruction": "sysctl ile devre dışı bırakın",
        "command": "echo 'fs.suid_dumpable = 0' | sudo tee -a /etc/sysctl.conf && sudo sysctl -p"
      }
    ],
    "verification": {
      "command": "ulimit -c",
      "expected": "0"
    }
  },
  "cis_xinetd": {
    "match_pattern": "CIS.*2\\.1\\.1.*xinetd.*aktif|xinetd.*aktif",
    "title": "CIS 2.1.1: xinetd Aktif",
    "description": "xinetd servisi çalışıyor, genellikle gerekli değil.",
    "steps": [
      {
        "instruction": "xinetd servisini durdurun",
        "command": "sudo systemctl stop xinetd"
      },
      {
        "instruction": "Servisi devre dışı bırakın",
        "command": "sudo systemctl disable xinetd"
      },
      {
        "instruction": "Gerekli değilse paketi kaldırın",
        "command": "sudo apt remove xinetd"
      }
    ],
    "verification": {
      "command": "systemctl is-active xinetd",
      "expected": "inactive"
    }
  },
  "cis_avahi": {
    "match_pattern": "CIS.*2\\.2\\.3.*avahi.*çalışıyor|avahi-daemon.*çalışıyor",
    "title": "CIS 2.2.3: avahi-daemon Çalışıyor",
    "description": "Avahi (zeroconf) servisi çalışıyor, sunucularda genellikle gereksiz.",
    "steps": [
      {
        "instruction": "Avahi servisini durdurun",
        "command": "sudo systemctl stop avahi-daemon"
      },
      {
        "instruction": "Servisi devre dışı bırakın",
        "command": "sudo systemctl disable avahi-daemon"
      }
    ],
    "verification": {
      "command": "systemctl is-active avahi-daemon",
      "expected": "inactive"
    }
  },
  "cis_ipv4_forward": {
    "match_pattern": "CIS.*3\\.1\\.1.*IPv4.*forwarding.*aktif",
    "title": "CIS 3.1.1: IPv4 Forwarding Aktif",
    "description": "IP forwarding etkin, sistem router olarak davranabilir.",
    "steps": [
      {
        "instruction": "sysctl.conf'u düzenleyin",
        "command": "sudo nano /etc/sysctl.conf"
      },
      {
        "instruction": "Forwarding'i devre dışı bırakın",
        "command": "net.ipv4.ip_forward = 0"
      },
      {
        "instruction": "Değişiklikleri uygulayın",
        "command": "sudo sysctl -p"
      }
    ],
    "verification": {
      "command": "sysctl net.ipv4.ip_forward",
      "expected": "0"
    }
  },
  "cis_source_route": {
    "match_pattern": "CIS.*3\\.2\\.1.*source.*routing.*aktif|Source.*routing.*aktif",
    "title": "CIS 3.2.1: Source Routing Aktif",
    "description": "Source routing kabul ediliyor, IP spoofing riski.",
    "steps": [
      {
        "instruction": "sysctl.conf'u düzenleyin",
        "command": "echo 'net.ipv4.conf.all.accept_source_route = 0' | sudo tee -a /etc/sysctl.conf"
      },
      {
        "instruction": "Değişiklikleri uygulayın",
        "command": "sudo sysctl -p"
      }
    ]
  },
  "cis_icmp_redirect": {
    "match_pattern": "CIS.*3\\.2\\.2.*ICMP.*redirects.*aktif",
    "title": "CIS 3.2.2: ICMP Redirects Aktif",
    "description": "ICMP redirect paketleri kabul ediliyor.",
    "steps": [
      {
        "instruction": "ICMP redirects'i devre dışı bırakın",
        "command": "echo 'net.ipv4.conf.all.accept_redirects = 0' | sudo tee -a /etc/sysctl.conf"
      },
      {
        "instruction": "Değişiklikleri uygulayın",
        "command": "sudo sysctl -p"
      }
    ]
  },
  "cis_syn_cookies": {
    "match_pattern": "CIS.*3\\.3\\.1.*SYN.*cookies.*devre.*dışı|TCP.*SYN.*cookies.*devre.*dışı",
    "title": "CIS 3.3.1: TCP SYN Cookies Devre Dışı",
    "description": "SYN cookies etkin değil, SYN flood saldırılarına açık.",
    "steps": [
      {
        "instruction": "SYN cookies'i etkinleştirin",
        "command": "echo 'net.ipv4.tcp_syncookies = 1' | sudo tee -a /etc/sysctl.conf"
      },
      {
        "instruction": "Değişiklikleri uygulayın",
        "command": "sudo sysctl -p"
      }
    ],
    "verification": {
      "command": "sysctl net.ipv4.tcp_syncookies",
      "expected": "1"
    }
  },
  "cis_auditd": {
    "match_pattern": "CIS.*4\\.1\\.1.*auditd.*çalışmıyor|auditd.*çalışmıyor",
    "title": "CIS 4.1.1: auditd Çalışmıyor",
    "description": "Linux audit daemon çalışmıyor, güvenlik olayları kaydedilemiyor.",
    "steps": [
      {
        "instruction": "auditd'yi kurun",
        "command": "sudo apt install auditd audispd-plugins"
      },
      {
        "instruction": "Servisi başlatın",
        "command": "sudo systemctl enable --now auditd"
      },
      {
        "instruction": "Temel audit kuralları ekleyin",
        "command": "sudo auditctl -w /etc/passwd -p wa -k identity"
      }
    ],
    "verification": {
      "command": "systemctl is-active auditd",
      "expected": "active"
    }
  },
  "cis_logging": {
    "match_pattern": "CIS.*4\\.2\\.1.*Logging.*servisi.*yok|Logging.*servisi.*yok",
    "title": "CIS 4.2.1: Logging Servisi Yok",
    "description": "Sistem logging servisi çalışmıyor.",
    "impact": "Güvenlik olayları kaydedilemiyor.",
    "steps": [
      {
        "instruction": "rsyslog durumunu kontrol edin",
        "command": "systemctl status rsyslog"
      },
      {
        "instruction": "rsyslog'u kurun (kurulu değilse)",
        "command": "sudo apt install rsyslog"
      },
      {
        "instruction": "Servisi başlatın",
        "command": "sudo systemctl enable --now rsyslog"
      }
    ],
    "verification": {
      "command": "systemctl is-active rsyslog",
      "expected": "active"
    }
  },
  "cis_varlog_perms": {
    "match_pattern": "CIS.*4\\.2\\.3.*/var/log.*izinleri.*gevşek|/var/log.*izinleri.*gevşek",
    "title": "CIS 4.2.3: /var/log İzinleri Gevşek",
    "description": "Log dizini izinleri çok açık.",
    "steps": [
      {
        "instruction": "/var/log izinlerini düzeltin",
        "command": "sudo chmod 750 /var/log"
      },
      {
        "instruction": "Log dosyalarını kontrol edin",
        "command": "sudo chmod 640 /var/log/*.log"
      }
    ],
    "verification": {
      "command": "stat -c %a /var/log",
      "expected": "750 veya daha kısıtlayıcı"
    }
  },
  "cis_sshd_perms": {
    "match_pattern": "CIS.*5\\.2\\.1.*sshd_config.*izinleri.*gevşek",
    "title": "CIS 5.2.1: sshd_config İzinleri Gevşek",
    "description": "SSH yapılandırma dosyası izinleri çok açık.",
    "steps": [
      {
        "instruction": "sshd_config izinlerini düzeltin",
        "command": "sudo chmod 600 /etc/ssh/sshd_config"
      },
      {
        "instruction": "Sahipliği kontrol edin",
        "command": "sudo chown root:root /etc/ssh/sshd_config"
      }
    ],
    "verification": {
      "command": "stat -c %a /etc/ssh/sshd_config",
      "expected": "600"
    }
  },
  "cis_ssh_x11": {
    "match_pattern": "CIS.*5\\.2\\.4.*X11.*forwarding.*aktif|SSH.*X11.*forwarding.*aktif",
    "title": "CIS 5.2.4: SSH X11 Forwarding Aktif",
    "description": "SSH X11 forwarding etkin, genellikle gereksiz.",
    "steps": [
      {
        "instruction": "sshd_config'i düzenleyin",
        "command": "sudo nano /etc/ssh/sshd_config"
      },
      {
        "instruction": "X11Forwarding'i devre dışı bırakın",
        "command": "X11Forwarding no"
      },
      {
        "instruction": "SSH'ı yeniden başlatın",
        "command": "sudo systemctl restart sshd"
      }
    ]
  },
  "cis_ssh_maxauth": {
    "match_pattern": "CIS.*5\\.2\\.5.*MaxAuthTries.*yüksek|SSH.*MaxAuthTries.*yüksek",
    "title": "CIS 5.2.5: SSH MaxAuthTries Yüksek",
    "description": "SSH maksimum deneme sayısı çok yüksek.",
    "steps": [
      {
        "instruction": "sshd_config'i düzenleyin",
        "command": "sudo nano /etc/ssh/sshd_config"
      },
      {
        "instruction": "MaxAuthTries değerini düşürün",
        "command": "MaxAuthTries 4",
        "note": "4 veya daha düşük önerilir"
      },
      {
        "instruction": "SSH'ı yeniden başlatın",
        "command": "sudo systemctl restart sshd"
      }
    ]
  },
  "cis_minlen": {
    "match_pattern": "CIS.*5\\.3\\.1.*şifre.*uzunluğu.*düşük|Minimum.*şifre.*uzunluğu.*düşük",
    "title": "CIS 5.3.1: Minimum Şifre Uzunluğu Düşük",
    "description": "Şifre politikası minimum uzunluğu yetersiz.",
    "steps": [
      {
        "instruction": "pwquality.conf'u düzenleyin",
        "command": "sudo nano /etc/security/pwquality.conf"
      },
      {
        "instruction": "Minimum uzunluğu artırın",
        "command": "minlen = 14",
        "note": "En az 14 karakter önerilir"
      }
    ],
    "verification": {
      "command": "grep minlen /etc/security/pwquality.conf",
      "expected": "14 veya daha yüksek"
    }
  },
  "cis_passwd_perms": {
    "match_pattern": "CIS.*6\\.1\\.1.*/etc/passwd.*izinleri.*gevşek|/etc/passwd.*izinleri.*gevşek",
    "title": "CIS 6.1.1: /etc/passwd İzinleri Gevşek",
    "description": "/etc/passwd dosya izinleri çok açık.",
    "steps": [
      {
        "instruction": "Doğru izinleri ayarlayın",
        "command": "sudo chmod 644 /etc/passwd"
      },
      {
        "instruction": "Sahipliği kontrol edin",
        "command": "sudo chown root:root /etc/passwd"
      }
    ],
    "verification": {
      "command": "stat -c %a /etc/passwd",
      "expected": "644"
    }
  },
  "cis_shadow_perms": {
    "match_pattern": "CIS.*6\\.1\\.2.*/etc/shadow.*izinleri.*gevşek|/etc/shadow.*izinleri.*gevşek",
    "title": "CIS 6.1.2: /etc/shadow İzinleri Gevşek",
    "description": "/etc/shadow dosya izinleri çok açık, şifre hash'leri tehlikede.",
    "impact": "Şifre hash'leri okunabilir, offline saldırı riski.",
    "steps": [
      {
        "instruction": "Doğru izinleri ayarlayın",
        "command": "sudo chmod 640 /etc/shadow"
      },
      {
        "instruction": "Sahipliği kontrol edin",
        "command": "sudo chown root:shadow /etc/shadow"
      }
    ],
    "verification": {
      "command": "stat -c %a /etc/shadow",
      "expected": "640 veya 600"
    }
  },
  "cis_uid0": {
    "match_pattern": "CIS.*6\\.2\\.1.*UID.*0.*hesabı|UID.*0.*hesabı.*var",
    "title": "CIS 6.2.1: Birden Fazla UID 0 Hesabı",
    "description": "Sistemde root dışında UID 0 hesabı var.",
    "impact": "Yetkisiz root erişimi, denetim zorluğu.",
    "steps": [
      {
        "instruction": "UID 0 hesaplarını listeleyin",
        "command": "awk -F: '($3 == 0) {print $1}' /etc/passwd"
      },
      {
        "instruction": "Gereksiz hesapları kilitleyin",
        "command": "sudo passwd -l HESAP_ADI"
      },
      {
        "instruction": "Veya UID'yi değiştirin",
        "command": "sudo usermod -u YENI_UID HESAP_ADI"
      }
    ],
    "verification": {
      "command": "awk -F: '($3 == 0)' /etc/passwd | wc -l",
      "expected": "1 (sadece root)"
    }
  },
  "audit_not_enabled": {
    "match_pattern": "(audit|denetim).*(kapalı|disabled|etkin.?değil)",
    "title": "Audit Sistemi Etkin Değil",
    "description": "Linux audit sistemi çalışmıyor, güvenlik olayları kaydedilmiyor.",
    "impact": "Güvenlik olayları takip edilemez, adli analiz yapılamaz.",
    "steps": [
      {
        "instruction": "auditd servisini kurun",
        "command": "sudo apt install auditd audispd-plugins"
      },
      {
        "instruction": "Servisi başlatın",
        "command": "sudo systemctl enable --now auditd"
      },
      {
        "instruction": "Temel kuralları yapılandırın",
        "command": "sudo auditctl -w /etc/passwd -p wa -k identity"
      }
    ],
    "verification": {
      "command": "systemctl is-active auditd",
      "expected": "active"
    }
  },
  "password_policy_weak": {
    "match_pattern": "(şifre|password).*(politika|policy).*(zayıf|weak)",
    "title": "Zayıf Şifre Politikası",
    "description": "Sistem şifre politikası güvenlik standartlarını karşılamıyor.",
    "steps": [
      {
        "instruction": "PAM pwquality modülünü yapılandırın",
        "command": "sudo nano /etc/security/pwquality.conf"
      },
      {
        "instruction": "Minimum gereksinimleri ayarlayın",
        "note": "minlen=12, dcredit=-1, ucredit=-1, lcredit=-1, ocredit=-1"
      },
      {
        "instruction": "Şifre yaşlandırma ayarlayın",
        "command": "sudo chage -M 90 -m 7 -W 14 KULLANICI"
      }
    ]
  },
  "logging_insufficient": {
    "match_pattern": "(log|günlük).*(yetersiz|insufficient|eksik)",
    "title": "Yetersiz Loglama",
    "description": "Sistem loglama yapılandırması yetersiz.",
    "steps": [
      {
        "instruction": "rsyslog yapılandırmasını kontrol edin",
        "command": "cat /etc/rsyslog.conf"
      },
      {
        "instruction": "Önemli logları etkinleştirin",
        "command": "sudo nano /etc/rsyslog.d/50-default.conf"
      },
      {
        "instruction": "Log rotasyonunu yapılandırın",
        "command": "sudo nano /etc/logrotate.conf"
      }
    ]
  },
  "selinux_disabled": {
    "match_pattern": "(SELinux|AppArmor).*(kapalı|disabled)",
    "title": "Zorunlu Erişim Kontrolü Kapalı",
    "description": "SELinux veya AppArmor gibi MAC sistemi etkin değil.",
    "impact": "Uygulamalar arası izolasyon zayıflar, exploit etkileri artabilir.",
    "steps": [
      {
        "instruction": "AppArmor durumunu kontrol edin",
        "command": "sudo aa-status"
      },
      {
        "instruction": "AppArmor'u etkinleştirin",
        "command": "sudo systemctl enable --now apparmor"
      },
      {
        "instruction": "Profilleri yükleyin",
        "command": "sudo aa-enforce /etc/apparmor.d/*"
      }
    ],
    "verification": {
      "command": "sudo aa-status | grep 'profiles are in enforce mode'",
      "expected": "Enforce modda profiller görünmeli"
    }
  }
}
