{
  "firewall_disabled": {
    "title": "Firewall Devre Dışı",
    "match_pattern": "firewall.*devre.*dışı|ufw.*inactive|iptables.*boş",
    "severity": "high",
    "impact": "Tüm portlar dışa açık olabilir",
    "steps": [
      {
        "order": 1,
        "instruction": "UFW firewall'u kurun (kurulu değilse)",
        "command": "sudo apt install ufw"
      },
      {
        "order": 2,
        "instruction": "SSH bağlantısına izin verin (önce bunu yapın!)",
        "command": "sudo ufw allow ssh",
        "note": "Bu adımı atlamayın, yoksa bağlantınız kesilir!"
      },
      {
        "order": 3,
        "instruction": "Varsayılan olarak gelen trafiği engelleyin",
        "command": "sudo ufw default deny incoming"
      },
      {
        "order": 4,
        "instruction": "Varsayılan olarak giden trafiğe izin verin",
        "command": "sudo ufw default allow outgoing"
      },
      {
        "order": 5,
        "instruction": "UFW'yi etkinleştirin",
        "command": "sudo ufw enable"
      }
    ],
    "verification": {
      "command": "sudo ufw status",
      "expected": "Status: active ve kurallar listesi"
    }
  },
  "ip_forwarding_enabled": {
    "title": "IP Forwarding Aktif",
    "match_pattern": "ip.*forward.*aktif|ip_forward.*1",
    "severity": "medium",
    "impact": "Sistem router olarak kullanılabilir",
    "steps": [
      {
        "order": 1,
        "instruction": "Sysctl yapılandırmasını düzenleyin",
        "command": "sudo nano /etc/sysctl.conf"
      },
      {
        "order": 2,
        "instruction": "IP forwarding'i devre dışı bırakın",
        "command": "net.ipv4.ip_forward = 0\nnet.ipv6.conf.all.forwarding = 0"
      },
      {
        "order": 3,
        "instruction": "Değişiklikleri uygulayın",
        "command": "sudo sysctl -p"
      }
    ],
    "verification": {
      "command": "sysctl net.ipv4.ip_forward",
      "expected": "net.ipv4.ip_forward = 0"
    }
  },
  "open_port_unknown": {
    "title": "Bilinmeyen Açık Port",
    "match_pattern": "bilinmeyen.*port|unknown.*port|dinleyen.*servis",
    "severity": "medium",
    "impact": "Potansiyel güvenlik açığı veya backdoor",
    "steps": [
      {
        "order": 1,
        "instruction": "Portu kullanan süreci belirleyin",
        "command": "sudo ss -tlnp | grep :PORT_NUMARASI"
      },
      {
        "order": 2,
        "instruction": "Sürecin ne olduğunu araştırın",
        "command": "ps aux | grep SUREC_ID"
      },
      {
        "order": 3,
        "instruction": "Gerekli değilse servisi durdurun",
        "command": "sudo systemctl stop SERVIS_ADI"
      },
      {
        "order": 4,
        "instruction": "Firewall'da portu engelleyin",
        "command": "sudo ufw deny PORT_NUMARASI"
      }
    ],
    "verification": {
      "command": "ss -tlnp | grep :PORT_NUMARASI",
      "expected": "Hiçbir sonuç dönmemelidir"
    }
  },
  "smtp_open": {
    "title": "SMTP Portu Dışa Açık",
    "match_pattern": "SMTP.*25.*açık|mail.*relay",
    "severity": "high",
    "impact": "Spam gönderimi için kullanılabilir",
    "steps": [
      {
        "order": 1,
        "instruction": "SMTP servisinin gerekli olup olmadığını değerlendirin",
        "command": null,
        "note": "Mail sunucusu değilse kapatın"
      },
      {
        "order": 2,
        "instruction": "Sadece localhost'tan erişime izin verin",
        "command": "sudo nano /etc/postfix/main.cf"
      },
      {
        "order": 3,
        "instruction": "inet_interfaces değerini localhost yapın",
        "command": "inet_interfaces = localhost"
      },
      {
        "order": 4,
        "instruction": "Postfix'i yeniden başlatın",
        "command": "sudo systemctl restart postfix"
      }
    ],
    "verification": {
      "command": "ss -tlnp | grep :25",
      "expected": "127.0.0.1:25 veya hiçbir sonuç"
    }
  },
  "icmp_redirect_enabled": {
    "title": "ICMP Redirect Aktif",
    "match_pattern": "ICMP.*redirect|icmp.*yönlendirme",
    "severity": "low",
    "impact": "Trafik yönlendirme saldırılarına açık",
    "steps": [
      {
        "order": 1,
        "instruction": "Sysctl yapılandırmasını düzenleyin",
        "command": "sudo nano /etc/sysctl.conf"
      },
      {
        "order": 2,
        "instruction": "ICMP redirect'leri devre dışı bırakın",
        "command": "net.ipv4.conf.all.accept_redirects = 0\nnet.ipv4.conf.default.accept_redirects = 0\nnet.ipv4.conf.all.send_redirects = 0"
      },
      {
        "order": 3,
        "instruction": "Değişiklikleri uygulayın",
        "command": "sudo sysctl -p"
      }
    ],
    "verification": {
      "command": "sysctl net.ipv4.conf.all.accept_redirects",
      "expected": "0 değeri"
    }
  },
  "ssh_open_all": {
    "title": "SSH Tüm Arayüzlerde Açık",
    "match_pattern": "SSH.*22.*tüm.*arayüz|SSH.*22.*açık",
    "severity": "medium",
    "impact": "SSH servisi tüm ağ arayüzlerinden erişilebilir",
    "steps": [
      {
        "instruction": "SSH yapılandırmasını düzenleyin",
        "command": "sudo nano /etc/ssh/sshd_config"
      },
      {
        "instruction": "ListenAddress ile belirli IP'ye kısıtlayın",
        "command": "ListenAddress 192.168.1.100",
        "note": "Kendi IP adresinizi yazın"
      },
      {
        "instruction": "SSH servisini yeniden başlatın",
        "command": "sudo systemctl restart sshd"
      },
      {
        "instruction": "Firewall ile ek koruma sağlayın",
        "command": "sudo ufw allow from 192.168.1.0/24 to any port 22"
      }
    ],
    "verification": {
      "command": "ss -tlnp | grep :22",
      "expected": "Belirli IP adresi gösterilmeli"
    }
  },
  "postgresql_open": {
    "title": "PostgreSQL Tüm Arayüzlerde Açık",
    "match_pattern": "PostgreSQL.*5432.*tüm.*arayüz|PostgreSQL.*5432.*açık",
    "severity": "high",
    "impact": "Veritabanı dışarıdan erişilebilir, veri sızıntısı riski",
    "steps": [
      {
        "instruction": "PostgreSQL yapılandırmasını düzenleyin",
        "command": "sudo nano /etc/postgresql/*/main/postgresql.conf"
      },
      {
        "instruction": "listen_addresses değerini localhost yapın",
        "command": "listen_addresses = 'localhost'"
      },
      {
        "instruction": "pg_hba.conf dosyasını da kontrol edin",
        "command": "sudo nano /etc/postgresql/*/main/pg_hba.conf",
        "note": "Uzaktan erişim kurallarını kısıtlayın"
      },
      {
        "instruction": "PostgreSQL'i yeniden başlatın",
        "command": "sudo systemctl restart postgresql"
      }
    ],
    "verification": {
      "command": "ss -tlnp | grep :5432",
      "expected": "127.0.0.1:5432 gösterilmeli"
    }
  },
  "redis_open": {
    "title": "Redis Tüm Arayüzlerde Açık",
    "match_pattern": "Redis.*6379.*tüm.*arayüz|Redis.*6379.*açık",
    "severity": "critical",
    "impact": "Şifresiz Redis uzaktan erişilebilir, veri kaybı/sızıntısı riski",
    "steps": [
      {
        "instruction": "Redis yapılandırmasını düzenleyin",
        "command": "sudo nano /etc/redis/redis.conf"
      },
      {
        "instruction": "bind değerini localhost yapın",
        "command": "bind 127.0.0.1 ::1"
      },
      {
        "instruction": "Şifre koruması ekleyin",
        "command": "requirepass GUCLU_SIFRE",
        "tip": "Güçlü bir şifre belirleyin"
      },
      {
        "instruction": "Redis'i yeniden başlatın",
        "command": "sudo systemctl restart redis"
      }
    ],
    "verification": {
      "command": "ss -tlnp | grep :6379",
      "expected": "127.0.0.1:6379 gösterilmeli"
    }
  },
  "mongodb_open": {
    "title": "MongoDB Tüm Arayüzlerde Açık",
    "match_pattern": "MongoDB.*27017.*tüm.*arayüz|MongoDB.*27017.*açık",
    "severity": "high",
    "impact": "Veritabanı dışarıdan erişilebilir, veri sızıntısı riski",
    "steps": [
      {
        "instruction": "MongoDB yapılandırmasını düzenleyin",
        "command": "sudo nano /etc/mongod.conf"
      },
      {
        "instruction": "bindIp değerini localhost yapın",
        "command": "net:\n  bindIp: 127.0.0.1"
      },
      {
        "instruction": "Authentication'ı etkinleştirin",
        "command": "security:\n  authorization: enabled"
      },
      {
        "instruction": "MongoDB'yi yeniden başlatın",
        "command": "sudo systemctl restart mongod"
      }
    ],
    "verification": {
      "command": "ss -tlnp | grep :27017",
      "expected": "127.0.0.1:27017 gösterilmeli"
    }
  },
  "source_routing": {
    "title": "Source Routing Kabul Ediliyor",
    "match_pattern": "source.*routing.*kabul|Source.*routing.*kabul",
    "severity": "medium",
    "impact": "IP spoofing saldırılarına açık",
    "steps": [
      {
        "instruction": "Sysctl yapılandırmasını düzenleyin",
        "command": "sudo nano /etc/sysctl.conf"
      },
      {
        "instruction": "Source routing'i devre dışı bırakın",
        "command": "net.ipv4.conf.all.accept_source_route = 0\nnet.ipv4.conf.default.accept_source_route = 0"
      },
      {
        "instruction": "Değişiklikleri uygulayın",
        "command": "sudo sysctl -p"
      }
    ],
    "verification": {
      "command": "sysctl net.ipv4.conf.all.accept_source_route",
      "expected": "0 değeri"
    }
  },
  "syn_cookies_disabled": {
    "title": "SYN Cookies Devre Dışı",
    "match_pattern": "SYN.*cookies.*devre.*dışı",
    "severity": "medium",
    "impact": "SYN flood saldırılarına karşı savunmasız",
    "steps": [
      {
        "instruction": "Sysctl yapılandırmasını düzenleyin",
        "command": "sudo nano /etc/sysctl.conf"
      },
      {
        "instruction": "SYN cookies'i etkinleştirin",
        "command": "net.ipv4.tcp_syncookies = 1"
      },
      {
        "instruction": "Değişiklikleri uygulayın",
        "command": "sudo sysctl -p"
      }
    ],
    "verification": {
      "command": "sysctl net.ipv4.tcp_syncookies",
      "expected": "1 değeri"
    }
  },
  "rp_filter_disabled": {
    "title": "Reverse Path Filtering Devre Dışı",
    "match_pattern": "Reverse.*path.*filtering.*devre.*dışı|rp_filter.*devre",
    "severity": "low",
    "impact": "IP spoofing saldırılarına daha açık",
    "steps": [
      {
        "instruction": "Sysctl yapılandırmasını düzenleyin",
        "command": "sudo nano /etc/sysctl.conf"
      },
      {
        "instruction": "Reverse path filtering'i etkinleştirin",
        "command": "net.ipv4.conf.all.rp_filter = 1\nnet.ipv4.conf.default.rp_filter = 1"
      },
      {
        "instruction": "Değişiklikleri uygulayın",
        "command": "sudo sysctl -p"
      }
    ],
    "verification": {
      "command": "sysctl net.ipv4.conf.all.rp_filter",
      "expected": "1 değeri"
    }
  },
  "suspicious_connection": {
    "title": "Şüpheli Port Bağlantısı",
    "match_pattern": "şüpheli.*port.*bağlantı|Şüpheli.*port.*bağlantı|suspicious.*port",
    "severity": "high",
    "impact": "Backdoor veya zararlı yazılım iletişimi olabilir",
    "steps": [
      {
        "instruction": "Şüpheli bağlantıları listeleyin",
        "command": "ss -tnp | grep -E ':4444|:5555|:1337|:31337'"
      },
      {
        "instruction": "Bağlantı yapan süreci tespit edin",
        "command": "sudo lsof -i :PORT_NUMARASI"
      },
      {
        "instruction": "Sürecin dosya yolunu kontrol edin",
        "command": "ls -la /proc/PID/exe"
      },
      {
        "instruction": "Şüpheli süreci sonlandırın",
        "command": "sudo kill -9 PID",
        "tip": "Önce sürecin ne olduğunu doğrulayın"
      },
      {
        "instruction": "Firewall ile portu engelleyin",
        "command": "sudo ufw deny out PORT_NUMARASI"
      }
    ]
  },
  "no_firewall": {
    "title": "Aktif Firewall Bulunamadı",
    "match_pattern": "Aktif.*firewall.*bulunamadı|firewall.*bulunamadı|firewall.*yok",
    "severity": "high",
    "impact": "Sistem güvenlik duvarı koruması olmadan çalışıyor",
    "steps": [
      {
        "instruction": "UFW firewall'u kurun",
        "command": "sudo apt install ufw"
      },
      {
        "instruction": "SSH'a izin verin (uzaktan bağlanıyorsanız)",
        "command": "sudo ufw allow ssh",
        "note": "Bu adımı atlamayın!"
      },
      {
        "instruction": "Varsayılan politikaları ayarlayın",
        "command": "sudo ufw default deny incoming && sudo ufw default allow outgoing"
      },
      {
        "instruction": "UFW'yi etkinleştirin",
        "command": "sudo ufw enable"
      }
    ],
    "verification": {
      "command": "sudo ufw status",
      "expected": "Status: active"
    }
  }
}
