{
  "scan": {
    "parallel": false,
    "threads": 4,
    "timeout": 300
  },
  "modules": {
    "enabled": ["all"],
    "disabled": []
  },
  "reporting": {
    "format": "terminal",
    "organize_by_date": true,
    "retention_days": 90,
    "log_retention_days": 30
  },
  "notifications": {
    "desktop": true,
    "email": false,
    "email_to": "",
    "webhook": "",
    "on_severity": ["critical", "high"]
  },
  "fim": {
    "enabled": true,
    "directories": [
      "/usr/bin",
      "/usr/sbin",
      "/bin",
      "/sbin",
      "/etc/passwd",
      "/etc/shadow",
      "/etc/group",
      "/etc/sudoers",
      "/etc/ssh/sshd_config",
      "/etc/crontab"
    ],
    "exclude_patterns": ["*.log", "*.tmp", "*.cache"]
  },
  "filters": {
    "min_severity": "low",
    "exclude_dirs": [
      "/proc",
      "/sys",
      "/dev",
      "/run",
      "/snap",
      "node_modules",
      ".cache",
      ".local/share/Trash",
      ".npm",
      ".yarn"
    ]
  },
  "exit_codes": {
    "critical": 2,
    "high": 1,
    "success": 0
  },
  "gnome": {
    "trusted_extensions": [
      "ubuntu-dock@ubuntu.com",
      "ubuntu-appindicators@ubuntu.com",
      "tiling-assistant@ubuntu.com",
      "ding@rastersoft.com"
    ]
  },
  "interface": {
    "language": "tr",
    "color": true,
    "verbose": false,
    "debug": false
  }
}
